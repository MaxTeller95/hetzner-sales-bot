# ---- Telegram -------------------------------------------------------------
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Comma-separated Telegram user ids that receive admin alerts and can approve top-ups
ADMIN_IDS=111111111

# ---- Security -------------------------------------------------------------
# Long random string. Encrypts stored root passwords / API tokens and signs dashboard sessions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later makes stored passwords and tokens unreadable.
SECRET_KEY=change-me

# ---- Database -------------------------------------------------------------
# docker-compose overrides this. For local dev without Postgres, SQLite works:
DATABASE_URL=sqlite+aiosqlite:///./hetzbot.db
# Optional: Redis for bot conversation state (in-memory if empty)
REDIS_URL=

# ---- Providers ------------------------------------------------------------
# Hetzner Cloud project API token (Read & Write). Used to create the first provider.
HETZNER_API_TOKEN=

# ---- Admin dashboard ------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
WEB_BASE_URL=https://admin.example.com
# true when served over HTTPS (recommended)
SESSION_HTTPS_ONLY=false

# ---- Runtime setting seeds (editable later in the dashboard) ---------------
DEFAULT_EXCHANGE_RATE_EUR=0
DEFAULT_EXCHANGE_RATE_USD=0
DEFAULT_PROFIT_MARGIN_PERCENT=35
DEFAULT_LOW_BALANCE_THRESHOLD=500000

# ---- Abuse mailbox (optional) ----------------------------------------------
# Mailbox that receives Hetzner abuse reports; servers whose IPs appear are locked.
ABUSE_IMAP_HOST=
ABUSE_IMAP_PORT=993
ABUSE_IMAP_USER=
ABUSE_IMAP_PASSWORD=
ABUSE_IMAP_FOLDER=INBOX
ABUSE_SENDER_FILTER=hetzner

WORKER_CONCURRENCY=5
LOG_LEVEL=INFO
